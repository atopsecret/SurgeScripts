{
  "id": 8,
  "scriptEntries": [
    {
      "name": "ios-youtube-ad-break",
      "type": "http-request",
      "pattern": "^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/player\\/ad_break(?:\\?.*)?$",
      "body": false,
      "handler": "ad-break"
    },
    {
      "name": "ios-youtube-download-player",
      "type": "http-request",
      "pattern": "^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/player(?:\\?.*)?$",
      "body": true,
      "handler": "native-download-player"
    },
    {
      "name": "ios-youtube-response",
      "type": "http-response",
      "pattern": "^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/(?:navigation\\/resolve_url|browse|next|player|search|reel\\/reel_watch_sequence|guide|account\\/get_setting|get_watch|config|log_event)(?:\\?.*)?$",
      "body": true,
      "handler": "core-or-key-or-native-settings"
    },
    {
      "name": "ios-youtube-download-action",
      "type": "http-response",
      "pattern": "^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/offline\\/get_download_action(?:\\?.*)?$",
      "body": true,
      "handler": "native-download-action"
    },
    {
      "name": "ios-youtube-ump",
      "type": "http-response",
      "pattern": "^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/initplayback(?:\\?.*)?$",
      "body": true,
      "handler": "encrypted-ump"
    },
    {
      "name": "ios-youtube-init",
      "type": "http-request",
      "pattern": "^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/initplayback(?:\\?.*)?$",
      "body": true,
      "handler": "initplayback-quality"
    },
    {
      "name": "ios-youtube-auto-hd",
      "type": "http-request",
      "pattern": "^https?:\\/\\/[\\w-]+\\.googlevideo\\.com\\/videoplayback(?:\\?.*)?$",
      "body": true,
      "handler": "highest-quality"
    },
    {
      "name": "ios-youtube-log-event",
      "type": "http-request",
      "pattern": "^https:\\/\\/youtubei\\.googleapis\\.com\\/youtubei\\/v1\\/log_event(?:\\?.*)?$",
      "body": false,
      "handler": "log-event-headers"
    },
    {
      "name": "ios-youtube-dual-subs",
      "type": "http-response",
      "pattern": "^https:\\/\\/(?:www|m)\\.youtube\\.com\\/api\\/timedtext(?:\\?|$)",
      "body": true,
      "handler": "dual-subtitles"
    }
  ]
}
