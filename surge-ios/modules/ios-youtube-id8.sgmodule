#!name=YouTube 增强 · iOS 完整迁移 ID8
#!desc=保留去广告、后台/PiP、最高画质、Shorts/竖屏直播过滤、Jump Ahead、原生下载与双语字幕；九入口由自包含 dispatcher 处理。
#!arguments=block_upload:true,block_shorts:true,auto_hd:true,block_games:true,block_vertical_live:true,jump_ahead:true,block_store:true,native_download:true,dual_subtitles:true,subtitle_language:zh-CN
#!arguments-desc=沿用现Egern参数。native_download为实验性客户端功能；dual_subtitles仅翻译现有字幕，失败保留原文。
#!requirement=SYSTEM = 'iOS'

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$2&$4&subtype=Translate$5 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)([^#]+)&tlang=([^&#]+)(#.*)?$ https://$1$2&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)&([^#]*)(#.*)?$ https://$1$3&subtype=Translate$4 302
^https://((?:www|m)\.youtube\.com/api/timedtext\?)tlang=([^&#]+)(#.*)?$ https://$1subtype=Translate$3 302

[Map Local]
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad data-type=text data="" status-code=200
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads data-type=text data="" status-code=200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) data-type=text data="" status-code=200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext data-type=text data="" status-code=200

[Script]
ios-youtube-ad-break = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player\/ad_break(?:\?.*)?$,requires-body=false,engine=jsc,timeout=10,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-request-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-download-player = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=1048576,engine=jsc,timeout=10,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-request-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(?:navigation\/resolve_url|browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|config|log_event)(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=4194304,engine=webview,timeout=20,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-response-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-download-action = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/offline\/get_download_action(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=1048576,engine=webview,timeout=20,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-response-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-ump = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=4194304,engine=webview,timeout=20,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-response-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=1048576,engine=jsc,timeout=10,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-request-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-auto-hd = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/videoplayback(?:\?.*)?$,requires-body=true,binary-body-mode=true,max-size=1048576,engine=jsc,timeout=10,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-request-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-log-event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=false,engine=jsc,timeout=10,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-request-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"
ios-youtube-dual-subs = type=http-response,pattern=^https:\/\/(?:www|m)\.youtube\.com\/api\/timedtext(?:\?|$),requires-body=true,binary-body-mode=true,max-size=2097152,engine=webview,timeout=45,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/youtube-id8-response-dispatch.js,argument="blockUpload={{{block_upload}}}&blockShorts={{{block_shorts}}}&autoHd={{{auto_hd}}}&blockGames={{{block_games}}}&blockVerticalLive={{{block_vertical_live}}}&jumpAhead={{{jump_ahead}}}&blockStore={{{block_store}}}&nativeDownload={{{native_download}}}&dualSubtitles={{{dual_subtitles}}}&subtitle_language={{{subtitle_language}}}"

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com, m.youtube.com
