#!name=红果短剧去广告
#!desc=拦截红果短剧/番茄系插播广告视频源与穿山甲广告请求（75 条精确域名），正片播放不受影响。附带拦截番茄埋点、友盟统计等追踪域名。
#!author=skernelx
#!homepage=https://github.com/skernelx/SurgeScripts
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
#!category=去广告

[Rule]
# ===== 红果/番茄 插播广告视频 CDN =====
# 广告专用子域名，正片域名 *-reading-video.qznovelvod.com 不在此列，播放不受影响
DOMAIN-SUFFIX,v5-reading-ad.qznovelvod.com,REJECT
