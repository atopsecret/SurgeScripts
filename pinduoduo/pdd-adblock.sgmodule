[Script]
拼多多去广告 = type=http-response,pattern=^https?://[^/]+/(api/(alexa/homepage/hub|philo/personal/hub|oak/integration/render|aristotle/order_list_v4)(?:\?|$)|order/|search(?:\?|$)),requires-body=true,max-size=131072,full-header-mode=true,engine=webview,script-update-interval=3600,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/pinduoduo/pdd-ad-block.js?v=eg-native-20261105-r1,timeout=30
拼多多去广告诊断 = type=generic,engine=webview,script-update-interval=3600,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/pinduoduo/pdd-ad-block.js?v=eg-native-20261105-r1,timeout=10

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, m.pinduoduo.net
