[Map Local]
^https://(?:[A-Za-z0-9-]+\.)*pangolin-sdk-toutiao(?:-b|1)?\.com(?::443)?/api/ad/union/sdk/ data-type=base64 data="e30=" status-code=200 header="Content-Type:application/json|Cache-Control:no-store"

[MITM]
hostname = %APPEND% *.pangolin-sdk-toutiao.com, *.pangolin-sdk-toutiao-b.com, *.pangolin-sdk-toutiao1.com
