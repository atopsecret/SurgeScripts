#!name=闲鱼去广告
#!desc=Surge iOS 6.x 迁移：eg-native-20261105-r1；六网关、新旧开屏及缓存广告原生处理；HTTP/ret 错误放行，默认静默，诊断只输出本地状态。
#!author=skernelx
#!homepage=https://github.com/atopsecret/SurgeScripts
# 当前 Egern 功能范围；不启用纯展示 widget，不改全局DNS、证书或代理。

[Rule]
URL-REGEX,^https?://ossgw\.alicdn\.com/creatives-assets/,REJECT
URL-REGEX,^https?://(bdlog|df)\.tanx\.com(?:/|$),REJECT

[Script]
ios-xianyu-adblock-response = type=http-response,pattern=^https?://(acs|g-acs|gw)\.m\.(goofish|taobao)\.com(?::[0-9]+)?/(gw|h5)/(mtop\.taobao\.idlecommerce\.splash\.(async\.)?ads|mtop\.idle\.idleadv\.(app\.launch\.report|scene\.restore)|mtop\.idle\.ad\.expose|mtop\.taobao\.idle\.user\.strategy\.list|mtop\.taobao\.idlehome\.home\.circle\.list)(?:/|$),requires-body=true,max-size=2097152,full-header-mode=true,engine=webview,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/common-xianyu-adblock.js,timeout=30
ios-xianyu-adblock-diagnostic = type=generic,engine=webview,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/surge-ios/scripts/common-xianyu-adblock.js,timeout=30

[MITM]
hostname = %APPEND% acs.m.goofish.com, acs.m.taobao.com, g-acs.m.goofish.com, g-acs.m.taobao.com, gw.m.goofish.com, gw.m.taobao.com, ossgw.alicdn.com, bdlog.tanx.com, df.tanx.com
