#!name=拼多多去广告
#!desc=eg-native-20261105-r1；原生页面净化、开屏空响应和 UA 双条件素材拦截；单域 QUIC 阻断，不封锁整个商品图片 CDN。
#!author=skernelx · FFDNS · RuCu6 · ZenmoFeiShi
#!homepage=https://github.com/atopsecret/SurgeScripts/tree/main/pinduoduo
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Advertising.png
#!category=去广告
#!tag=去广告,拼多多,pdd
#!openUrl=https://apps.apple.com/cn/app/id1044283059
# Surge iOS 6.x；替换旧版同名模块，避免重复处理。不修改全局 DNS、CA 或代理。

[Rule]
AND,((URL-REGEX,^http://(?:(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(?:25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/d[0-9]?(?:\?|$)),(USER-AGENT,*com.xunmeng.pinduoduo*)),REJECT
AND,((URL-REGEX,^http://\[[0-9a-fA-F:]+\]/d[0-9]?\?),(USER-AGENT,*com.xunmeng.pinduoduo*)),REJECT
AND,((DOMAIN,api.pinduoduo.com),(PROTOCOL,QUIC)),REJECT
AND,((URL-REGEX,^http://[^/]+/v3/d\?(?:[^#]*&)?type=addrs(?:&|$)),(USER-AGENT,*pinduoduo*)),REJECT
DOMAIN,promotion-2.pddpic.com,REJECT
DOMAIN,video-snapshot01.pddpic.com,REJECT
DOMAIN,titan.pinduoduo.com,REJECT
DOMAIN,xg.pinduoduo.com,REJECT
DOMAIN,apm.pinduoduo.com,REJECT
DOMAIN,apm-a.pinduoduo.com,REJECT
DOMAIN,th.pinduoduo.com,REJECT
DOMAIN,th-a.pinduoduo.com,REJECT
DOMAIN,th-b.pinduoduo.com,REJECT
DOMAIN,ta.pinduoduo.com,REJECT
DOMAIN,ta-a.pinduoduo.com,REJECT
DOMAIN,meta.pinduoduo.com,REJECT

