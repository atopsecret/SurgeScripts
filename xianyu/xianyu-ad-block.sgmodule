#!name=闲鱼去广告
#!desc=eg-native-20261105-r1；六网关、新旧开屏及缓存广告原生处理；HTTP/ret 错误放行，默认静默，诊断只输出本地状态。
#!author=skernelx
#!homepage=https://github.com/atopsecret/SurgeScripts
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Xianyu.png
#!category=去广告
#!tag=去广告,闲鱼,goofish
#!openUrl=https://apps.apple.com/cn/app/id510909202
# Surge iOS 6.x；替换旧版同名模块，避免重复处理。不修改全局 DNS、CA 或代理。

[Rule]
URL-REGEX,^https?://ossgw\.alicdn\.com/creatives-assets/,REJECT
URL-REGEX,^https?://(bdlog|df)\.tanx\.com(?:/|$),REJECT

[Script]
闲鱼去广告-开屏 = type=http-response,pattern=^https?://(acs|g-acs|gw)\.m\.(goofish|taobao)\.com(?::[0-9]+)?/(gw|h5)/(mtop\.taobao\.idlecommerce\.splash\.(async\.)?ads|mtop\.idle\.idleadv\.(app\.launch\.report|scene\.restore)|mtop\.idle\.ad\.expose|mtop\.taobao\.idle\.user\.strategy\.list|mtop\.taobao\.idlehome\.home\.circle\.list)(?:/|$),requires-body=true,max-size=2097152,full-header-mode=true,engine=webview,script-update-interval=3600,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/xianyu/xianyu-ad-block.js?v=eg-native-20261105-r1,timeout=30
闲鱼去广告诊断 = type=generic,engine=webview,script-update-interval=3600,script-path=https://raw.githubusercontent.com/atopsecret/SurgeScripts/main/xianyu/xianyu-ad-block.js?v=eg-native-20261105-r1,timeout=30

[MITM]
hostname = %APPEND% acs.m.goofish.com, acs.m.taobao.com, g-acs.m.goofish.com, g-acs.m.taobao.com, gw.m.goofish.com, gw.m.taobao.com, ossgw.alicdn.com, bdlog.tanx.com, df.tanx.com
